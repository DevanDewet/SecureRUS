# Environment Configuration
NODE_ENV=development
PORT=3000

# Security Keys (CHANGE THESE IN PRODUCTION!)
# Generate secure random keys with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# Database
DB_PATH=./database/secureus.db

# MFA Settings
MFA_SERVICE_NAME=SecureRUS
MFA_ISSUER=SecureRUS-Security

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# File Upload Limits (in bytes)
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
MAX_CONFIDENTIAL_SIZE=2097152

# Application Settings
APP_NAME=SecureRUS RBAC System
ADMIN_EMAIL=admin@secureus.com
